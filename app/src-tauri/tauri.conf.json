{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YTLiveRecorder",
  "version": "0.1.0",
  "identifier": "tw.ebc.yt-live-recorder",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "YT 直播錄製工具",
        "width": 1000,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "TradChinese",
          "English"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/JohnnyShihHg/yt-live-recorder/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg4RTNDNTQ0NkU2REFBNDEKUldSQnFtMXVSTVhqaUhYTUYveERVQTh3cFZYTFlhaW9FK0paRitrZW8yRGp6L2s2YkJNTlBlcGMK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
